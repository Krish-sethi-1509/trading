DATABASE_URL=postgresql+psycopg://gold_user:change_me@localhost:5432/gold_mvp
# Deployment aliases accepted by the backend and documented in ../.env.example.
GOLD_API_KEY=your_goldapi_key
LLM_API_KEY=your_openai_or_anthropic_key
SEARCH_API_KEY=your_tavily_or_serper_key
FRONTEND_URL=http://localhost:5173
# Used if GOLDAPI_API_KEY is absent; Twelve Data's /price endpoint does not provide bid/ask.
TWELVE_DATA_API_KEY=your_twelve_data_key
# Absolute path recommended. Step 3 trainer saves the fitted imputer/scaler/model pipeline here.
MODEL_PATH=../step3/artifacts/xgb/xgboost_pipeline.joblib
# Optional separate scaler for a separately saved model. Do not set for the Step 3 pipeline artifact.
# SCALER_PATH=/absolute/path/to/scaler.joblib
# Optional JSON array if the model artifact does not retain its feature names.
# MODEL_FEATURES_PATH=/absolute/path/to/model_features.json
# Provide regularly refreshed engineered features or persist them into price_history.feature_vector.
FEATURES_CSV_PATH=../step3/data/features_latest.csv
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
PREDICTION_HORIZON_HOURS=4
NEUTRAL_RETURN_THRESHOLD=0.001
LOG_LEVEL=INFO
MARKET_DATA_TIMEOUT_SECONDS=12
PRICE_FALLBACK_MAX_STALE_SECONDS=900
PRICE_CACHE_SECONDS=15
FEATURE_MAX_AGE_SECONDS=900
OUTCOME_MAX_DELAY_SECONDS=900
SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=your_tavily_key
# Set SEARCH_PROVIDER=serper and SERPER_API_KEY instead to use Serper News.
# SERPER_API_KEY=your_serper_key
LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-6-astra
# Or set LLM_PROVIDER=anthropic and configure these instead:
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_MODEL=claude-sonnet-4-5
