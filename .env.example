# Render/PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Public frontend origin; backend appends this to CORS_ORIGINS.
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gold quote and Step 3 ingestion providers
GOLD_API_KEY=your_goldapi_key
TWELVE_DATA_API_KEY=your_twelve_data_key
FRED_API_KEY=your_fred_key
PRICE_FALLBACK_MAX_STALE_SECONDS=900
MARKET_DATA_TIMEOUT_SECONDS=12

# RAG provider selectors and generic keys accepted by chat_service.py
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_anthropic_key
OPENAI_MODEL=gpt-6-astra
# For Anthropic use LLM_PROVIDER=anthropic and optionally set ANTHROPIC_MODEL.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_tavily_or_serper_key

# Trained model + latest feature vector location (paths are relative to outputs/).
MODEL_PATH=step3/artifacts/xgb/xgboost_pipeline.joblib
FEATURES_CSV_PATH=step3/data/features_latest.csv
PREDICTION_HORIZON_HOURS=4
NEUTRAL_RETURN_THRESHOLD=0.001
LOG_LEVEL=INFO
